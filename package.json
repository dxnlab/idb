{
  "name": "@dxnlab/idb",
  "version": "0.0.6",
  "description": "indexeddb-decorator; Simplify indexeddb(https://developer.mozilla.org/en-US/docs/Web/API/IndexedDB_API) usage with Typescript decorator wrapper (stage3; https://devblogs.microsoft.com/typescript/announcing-typescript-5-0/#decorators)",
  "license": "LGPL-3.0-or-later",
  "keywords": [
    "idb",
    "indexeddb",
    "decorator"
  ],
  "homepage": "https://github.com/dxnlab/idb#readme",
  "bugs": {
    "url": "https://github.com/dxnlab/idb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxnlab/idb.git"
  },
  "author": "yg.song <yg.song@dxnlab.com>",
  "type": "module",
  "exports": {
    ".": {
      "main": "./dist/index.js",
      "browser": "./dits/index.js",
      "types": "dist/index.d.ts"
    },
    "./undeco": {
      "main": "./dist/undeco.js",
      "browser": "./dist/undeco.js",
      "types": "./dist/undeco.d.ts"
    }
  },
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test:all": "wdio run ./wdio.conf.ts > wdio.test.all.log",
    "test:spec": "wdio run ./wdio.conf.ts --verbose --spec ",
    "test:watch": "wdio run ./wdio.conf.ts --verbose --watch --spec ",
    "dev": "vite -c ./vite.preview.ts",
    "build:preview": "vite -c ./vite.preview.ts build"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@mdi/font": "^7.4.47",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/node": "^25.9.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "@wdio/browser-runner": "^9.31.1",
    "@wdio/cli": "^9.31.1",
    "@wdio/globals": "^9.31.1",
    "@wdio/logger": "^9.29.1",
    "@wdio/mocha-framework": "^9.31.1",
    "@wdio/spec-reporter": "^9.31.1",
    "aria-query": "^5.3.2",
    "css-shorthand-properties": "1.1.2",
    "css-value": "0.0.1",
    "deepmerge-ts": "^7.1.6",
    "expect": "^30.4.1",
    "expect-webdriverio": "^5.7.0",
    "grapheme-splitter": "1.0.4",
    "jest-matcher-utils": "^30.4.1",
    "jest-util": "^30.4.1",
    "lodash.clonedeep": "4.5.0",
    "lodash.flattendeep": "^4.4.0",
    "lodash.merge": "^4.6.2",
    "lodash.pickby": "^4.6.0",
    "lodash.zip": "^4.2.0",
    "minimatch": "^10.2.6",
    "mocha": "^11.8.0",
    "p-iteration": "^1.1.8",
    "rgb2hex": "^0.2.5",
    "split2": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-typescript-transform": "^1.3.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vue-tsc": "link:/vue-tsc",
    "vuetify": "^4.1.11",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=12.20"
  },
  "categories": [
    "Data Science",
    "Database",
    "Data Management"
  ]
}
